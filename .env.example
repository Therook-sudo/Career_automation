# =========================================================================
# Autonomous Pipeline Environment Variables
# =========================================================================

# 1. Supabase Configuration (Database & Auth)
# Get from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Telegram Bot Configuration
# Get token from: Open Telegram -> Search @BotFather -> /newbot
# Get user ID from: Open Telegram -> Search @userinfobot -> Send message
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_ALLOWED_USER_ID=123456789

# 3. AI Models APIs
# Gemini API Key (1,500 free requests/day): Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Moonshot Kimi API Key (Moonshot AI / Kimi k1.5 / Kimi k3): Get from https://platform.moonshot.cn/ or OpenRouter https://openrouter.ai/keys
KIMI_API_KEY=sk-...

# 4. Email Senders (Resend Cold Email API)
# Get key from: https://resend.com/api-keys
# Sender email: Use your verified domain email (e.g. alex@yourdomain.com) or testing 'onboarding@resend.dev'
RESEND_API_KEY=re_...
OUTREACH_SENDER_EMAIL=outreach@yourdomain.com

# 5. Live Google Sheets Sync (Optional)
# Get Spreadsheet ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1abc...
